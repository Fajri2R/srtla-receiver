# Rendered by the nginx image entrypoint (20-envsubst-on-templates.sh) into
# /etc/nginx/conf.d/default.conf at container start.
#
# Only ${LP_VPS_IP} and ${LP_SRT_DOMAIN} are substituted; every other $token is
# an nginx variable. Leave both empty for an IP-only or auto-detected setup.

server {
    listen 80 default_server;
    server_name _;

    # Per-deployment host hints for the browser injector. Served as JSON so
    # lp-inject.js can pick the right SRT/SRTLA host without hardcoding it.
    location = /lp-config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"vpsIp":"${LP_VPS_IP}","srtDomain":"${LP_SRT_DOMAIN}"}';
    }

    # Serve the Live Preview injector script (mounted from host)
    location = /lp-inject.js {
        alias /etc/nginx/lp-inject.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store";
    }

    # Ashveil design-system skin for the vendor SPA. Injected into <head> so it
    # paints with the first frame instead of flashing the default theme.
    location = /ashveil-sls.css {
        alias /etc/nginx/ashveil-sls.css;
        default_type text/css;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Canonical identity assets — byte-identical to the Control Hub set.
    location = /ashveil-veil.png {
        alias /etc/nginx/ashveil-veil.png;
        add_header Cache-Control "public, max-age=86400";
        default_type image/png;
    }

    location = /brand-mark.svg {
        alias /etc/nginx/brand-mark.svg;
        add_header Cache-Control "public, max-age=604800";
        default_type image/svg+xml;
    }

    location = /favicon.svg {
        alias /etc/nginx/favicon.svg;
        add_header Cache-Control "public, max-age=86400";
        default_type image/svg+xml;
    }

    location = /favicon-dark.svg {
        alias /etc/nginx/favicon-dark.svg;
        add_header Cache-Control "public, max-age=86400";
        default_type image/svg+xml;
    }

    location = /favicon-light.svg {
        alias /etc/nginx/favicon-light.svg;
        add_header Cache-Control "public, max-age=86400";
        default_type image/svg+xml;
    }

    location = /favicon-32.png {
        alias /etc/nginx/favicon-32.png;
        add_header Cache-Control "public, max-age=86400";
        default_type image/png;
    }

    location = /favicon.ico {
        alias /etc/nginx/favicon.ico;
        add_header Cache-Control "public, max-age=86400";
        default_type image/x-icon;
    }

    location = /apple-touch-icon.png {
        alias /etc/nginx/apple-touch-icon.png;
        add_header Cache-Control "public, max-age=86400";
        default_type image/png;
    }

    # Patch the vendor UI polling countdown at the proxy layer. The bundled
    # app normally refreshes publisher stats every 5/10 seconds; this keeps
    # the original component flow but resets its countdown to one second.
    location ~ ^/static/js/main\..+\.js$ {
        proxy_pass         http://sls-management-ui:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Accept-Encoding   "";
        proxy_read_timeout 60s;

        sub_filter_once  on;
        sub_filter_types application/javascript text/javascript;
        sub_filter '[s,u]=(0,t.useState)(10);(0,t.useEffect)((()=>{u(a?5:10)}),[a])' '[s,u]=(0,t.useState)(3);(0,t.useEffect)((()=>{u(3)}),[a])';
        # Older images bake the API base URL in at build time. Rewrite the
        # rendered origin so an HTTPS dashboard never issues blocked calls.
        sub_filter '"http://${LP_VPS_IP}:8080"' 'location.origin';
        # The bundle derives SRT/SRTLA hostnames from apiEndpoint, which is the
        # dashboard host and therefore unreachable over UDP. Point that helper
        # at the runtime-selected host instead.
        sub_filter 'Uo=()=>{try{return new URL(wt.apiEndpoint).hostname}catch{return"localhost"}}' 'Uo=()=>window.__LP_SRT_HOST||"${LP_VPS_IP}"';
        # The statistics URL is rewritten in lp-inject.js: its bundle template
        # contains "${...}", which nginx would parse as its own variables here.
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Same-origin proxy for the SLS receiver API. The management UI bundle
    # uses relative URLs after the rewrite above, while the receiver remains
    # private behind this proxy.
    location = /health {
        proxy_pass         http://receiver:8080/health;
        proxy_http_version 1.1;
        proxy_read_timeout 10s;
    }

    location ^~ /api/stream-ids {
        proxy_pass         http://receiver:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    location ^~ /stats/ {
        proxy_pass         http://receiver:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    # Same-origin proxy for HLS streams
    location /hls/ {
        proxy_pass         http://live-preview:80/hls/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 10s;
        add_header Access-Control-Allow-Origin * always;
    }

    location = /api/hls-health {
        proxy_pass         http://hls-manager:9090/health;
        proxy_http_version 1.1;
        proxy_read_timeout 10s;
    }

    location = /api/apikey {
        proxy_pass         http://hls-manager:9090/api/apikey;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_read_timeout 10s;
    }

    location /api/brand {
        proxy_pass         http://hls-manager:9090;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_read_timeout 10s;
        client_max_body_size 2m;
    }

    location / {
        proxy_pass         http://sls-management-ui:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 60s;

        # Inject Live Preview script tag before </body>
        # The JS file is served at /lp-inject.js by this same nginx.
        # sub_filter_types defaults to text/html, so it is not repeated here.
        sub_filter_once  on;
        sub_filter '</head>' '<script>try{var ashT=localStorage.getItem("ashveil-theme"),ashL=localStorage.getItem("ashveil-lang");if(ashL!=="id"&&ashL!=="en")ashL=(""+(navigator.language||"")).toLowerCase().slice(0,2)==="id"?"id":"en";document.documentElement.setAttribute("data-theme",ashT==="light"?"light":"dark");document.documentElement.setAttribute("lang",ashL);document.documentElement.setAttribute("data-lang",ashL)}catch(e){document.documentElement.setAttribute("data-theme","dark");document.documentElement.setAttribute("lang","en");document.documentElement.setAttribute("data-lang","en")}</script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"><link rel="stylesheet" href="/ashveil-sls.css?v=20261107c"></head>';
        sub_filter '</body>' '<script src="/lp-inject.js"></script></body>';
    }
}
